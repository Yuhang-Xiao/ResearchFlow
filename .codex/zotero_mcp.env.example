# Copy this file to `.codex/zotero_mcp.env`.
# Do not commit the real `.env` file.
#
# Optional Zotero MCP/API settings. Fill these locally when needed.
# Store any Zotero credential in the real ignored env file, not here.
ZOTERO_LIBRARY_ID=replace_with_your_library_id
ZOTERO_LIBRARY_TYPE=user
ZOTERO_LOCAL=true
